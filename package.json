{
  "name": "wikiwise-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspaces --if-present test",
    "electron:dev": "npm --workspace @wikiwise/electron-app run dev",
    "electron:package:mac": "npm --workspace @wikiwise/electron-app run package:mac"
  }
}
